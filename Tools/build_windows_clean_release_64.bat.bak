@ECHO OFF
SETLOCAL

SET BUILD_DIR=BuildRelease64
SET BUILD_TARGET_PATH=%~dp0..\%BUILD_DIR%

IF EXIST "%BUILD_TARGET_PATH%" RMDIR /Q /S "%BUILD_TARGET_PATH%"
MKDIR "%BUILD_TARGET_PATH%"

REM Build RL interface if enabled
IF "%OG_RL%"=="ON" (
    ECHO Building RL interface...
    PUSHD "%~dp0..\rl_interface"
    REM Try VS2022
    cmake -DOG_RL=ON -G "Visual Studio 17 2022" -A x64 ..
    IF %ERRORLEVEL% NEQ 0 (
        REM Fallback to VS2019
        ECHO Fallback to Visual Studio 16 2019
        cmake -DOG_RL=ON -G "Visual Studio 16 2019" -A x64 ..
    )
    IF %ERRORLEVEL% NEQ 0 (
        ECHO Error: CMake configuration for RL interface failed
        EXIT /B %ERRORLEVEL%
    )
    cmake --build . --config Release
    IF %ERRORLEVEL% NEQ 0 (
        ECHO Error: Build for RL interface failed
        EXIT /B %ERRORLEVEL%
    )
    REM Copy DLL
    IF EXIST "Release\og_env.pyd" (
        COPY "Release\og_env.pyd" "%~dp0..\python\"
        IF %ERRORLEVEL% NEQ 0 (
            ECHO Error: Copying og_env.pyd failed
            EXIT /B %ERRORLEVEL%
        )
    ) ELSE (
        ECHO Warning: og_env.pyd not found
    )
    POPD
) ELSE (
    ECHO Skipping RL interface build (OG_RL is not ON)
)

PUSHD "%BUILD_TARGET_PATH%"
cmake ../Projects -G "Visual Studio 15 2017 Win64"
CD ..
cmake --build "%BUILD_DIR%" --config Release
POPD

ECHO done
